# Shared
SERVICE_NAME=smart-novel

# Backend Configuration
BACKEND_PORT=3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:8080,
LOG_LEVEL=debug
LOG_MODE=PLAIN_TEXT
TTS_ENDPOINT=http://tts:3000/speak
EXPLAIN_CONTEXT_CHAR_SIZE=250

# MinIO Configuration
OBJECT_STORAGE_REGION=eu
OBJECT_STORAGE_ENDPOINT=http://s3:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Frontend Configuration
FRONTEND_PORT=4200
VITE_SERVICE_URL=http://localhost:8080
# OIDC settings for the React SPA (used by oidc-client-ts / react-oidc-context)
VITE_OIDC_AUTHORITY=http://localhost:8080
# VITE_OIDC_CLIENT_ID=  # Set after Zitadel creates the OIDC application
VITE_OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
VITE_OIDC_SCOPE='openid profile email urn:zitadel:iam:org:project:id:zitadel:aud urn:zitadel:iam:org:projects:roles urn:zitadel:iam:user:metadata'

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=30s
OLLAMA_CACHE_TTL=12h
OLLAMA_RETRY_COUNT=3
OLLAMA_RETRY_DELAY=1s

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_novel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Prisma Database URL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/smart_novel

# PGAdmin Configuration
PGADMIN_EXPOSED_PORT=5050

# Redis Configuration (passwordless for local dev, set password for production)
REDIS_URL=redis://redis:6379
# REDIS_PASSWORD=
REDIS_MAXMEMORY_POLICY=allkeys-lfu
REDIS_PORT=6379

# ZITADEL Configuration
ZITADEL_DOMAIN=http://localhost:8080
ZITADEL_ISSUER_URL=http://localhost:8080
# Internal Docker network URL for OIDC discovery (routed through Traefik so
# the Host header always matches ZITADEL_EXTERNALDOMAIN).
ZITADEL_INTERNAL_URL=http://traefik:80
# OIDC client ID — optional. If set, used directly. Otherwise read from ZITADEL_CLIENT_ID_FILE.
# ZITADEL_CLIENT_ID=
# Path to the file containing the auto-generated OIDC client ID (written by init-zitadel-users).
ZITADEL_CLIENT_ID_FILE=/zitadel-pat/client-id
# Service account PAT — optional. If set, used directly. Otherwise read from ZITADEL_PAT_FILE.
# ZITADEL_PAT=
# Path to the file containing the service account PAT (written by ZITADEL on first start).
ZITADEL_PAT_FILE=/zitadel-pat/token
ZITADEL_CALLBACK_URL=http://localhost:3000/auth/callback/zitadel
ZITADEL_POST_LOGIN_URL=http://localhost:8080
ZITADEL_POST_LOGOUT_URL=http://localhost:8080
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=Admin123!

# Session Configuration
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
SESSION_DURATION=3600

# Traefik
TRAEFIK_EXPOSED_PORT=8080
